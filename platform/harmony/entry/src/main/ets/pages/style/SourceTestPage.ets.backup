import { router } from '@kit.ArkUI';
import { hilog } from '@kit.PerformanceAnalysisKit';
import { DOMAIN } from '../../constants/HiLogConstants';
import { TestPageLayout } from '../common/TestPageLayout';

import { CircleLayer, FillLayer, GeoJsonSource, ImageSource, LatLng, LatLngBounds, LineLayer, MapLibreMap, MapView, Point, Polygon, RasterDemSource, RasterSource, VectorSource, maplibre, MapLibreMapOptions , NativeMapView, GeoJson, IFeature} from 'maplibre_harmony';
// 从 ETS 层导入 Layer 和 Source 封装类
const TAG = 'SourceTestPage';

/**
 * 随机位置接口
 */
interface RandomLocation {
  longitude: number;
  latitude: number;
}

/**
 * Source 数据源测试页面
 * 
 * 测试功能：
 * 1. GeoJsonSource - 各种几何类型（点、线、面）
 * 2. VectorSource - 矢量瓦片数据源
 * 3. RasterSource - 栅格瓦片数据源
 * 4. RasterDemSource - DEM 数据源
 * 5. ImageSource - 图像数据源
 * 
 * 使用新的 NAPI API：
 * - new GeoJsonSource(id)
 * - new VectorSource(id)
 * - new RasterSource(id)
 * - source.setGeoJson(data)
 * - source.setUrl(url)
 * - style.addSource(source)
 */

// GeoJSON类型定义
interface GeoJSONGeometry {
  type: string;
  coordinates: number[] | number[][] | number[][][] | number[][][][]
}

interface GeoJSONFeature {
  type: string;
  geometry: GeoJSONGeometry;
  properties: ESObject;
}

interface GeoJSONFeatureCollection {
  type: string;
  features: Array<GeoJSONFeature>;
}

@Entry
@Component
struct SourceTestPage {
  @State message: string = 'Source 数据源测试';
  private nativeMapView: NativeMapView | null = null;
  private mapLibreMap: MapLibreMap | null = null;
  @State currentSource: string = '无';
  @State mapReady: boolean = false;
  @State isInitializing: boolean = false;

  @Builder
  buildMapContent() {
    Stack() {
      MapView({
        styleUrl: 'https://demotiles.maplibre.org/style.json',
        initialLatitude: 39.9,
        initialLongitude: 116.4,
        initialZoom: 10,
        initialBearing: 0,
        initialPitch: 0,
        onMapReady: (map: MapLibreMap) => {
          this.initializeMap(map);
        }
      })
        .width('100%')
        .height('100%')

      // 加载指示器
      if (!this.mapReady) {
        Column() {
          LoadingProgress()
            .width(50)
            .height(50)
            .color('#2196F3')

          Text('地图加载中...')
            .fontSize(16)
            .margin({ top: 10 })
        }
        .width('100%')
        .height('100%')
        .justifyContent(FlexAlign.Center)
        .backgroundColor('rgba(255, 255, 255, 0.8)')
      }
    }
    .width('100%')
    .height('100%')
  }

  @Builder
  buildControlPanel() {
    // 当前数据源显示
    Text(`当前数据源: ${this.currentSource}`)
      .fontSize(14)
      .width('100%')
      .backgroundColor('#F8F8F8')
      .borderRadius(4)
    
    Text('GeoJsonSource 测试')
      .fontSize(16)
      .fontWeight(FontWeight.Bold)
      .width('100%')
    Row() {
      Button('点数据 (Point)')
        .onClick(() => this.handleTestGeoJsonPoint())
        .width('48%')
        .backgroundColor('#2196F3')

      Button('线数据 (LineString)')
        .onClick(() => this.handleTestGeoJsonLine())
        .width('48%')
        .margin({ left: 8 })
        .backgroundColor('#2196F3')
    }
    .width('100%')
    Row() {
      Button('面数据 (Polygon)')
        .onClick(() => this.handleTestGeoJsonPolygon())
        .width('48%')
        .backgroundColor('#2196F3')

      Button('多点聚类')
        .onClick(() => this.handleTestGeoJsonCluster())
        .width('48%')
        .margin({ left: 8 })
        .backgroundColor('#2196F3')
    }
    .width('100%')
    Button('从 URL 加载')
      .onClick(() => this.handleTestGeoJsonFromUrl())
      .width('48%')
      .backgroundColor('#2196F3')

    Divider().strokeWidth(2)

    Text('VectorSource 测试')
      .fontSize(16)
      .fontWeight(FontWeight.Bold)
      .width('100%')
    Button('矢量瓦片数据源')
      .onClick(() => this.handleTestVectorSource())
      .width('48%')
      .backgroundColor('#4CAF50')

    Divider().strokeWidth(2)

    Text('RasterSource 测试')
      .fontSize(16)
      .fontWeight(FontWeight.Bold)
      .width('100%')
    Row() {
      Button('OSM 栅格瓦片')
        .onClick(() => this.handleTestRasterSource())
        .width('48%')
        .backgroundColor('#FF9800')

      Button('卫星影像')
        .onClick(() => this.handleTestRasterSourceSatellite())
        .width('48%')
        .margin({ left: 8 })
        .backgroundColor('#FF9800')
    }
    .width('100%')
    Divider().strokeWidth(2)

    Button('清除所有数据源')
      .onClick(() => this.handleClearAllSources())
      .width('48%')
      .backgroundColor(Color.Red)
  }

  build() {
    Column() {
      TestPageLayout({
        showActionBar: true,
        title: this.message,
        mapContent: this.buildMapContent,
        controlPanel: this.buildControlPanel
      })
    }
    .width('100%')
    .height('100%')
  }

  /**
   * 生成随机位置（中国区域）
   */
  private generateRandomLocation(): RandomLocation {
    // 中国区域：经度 70-135，纬度 15-55
    const longitude: number = 70 + Math.random() * 65;
    const latitude: number = 15 + Math.random() * 40;
    return { longitude, latitude };
  }

  /**
   * FlyTo 到指定边界范围
   */
  private flyToBounds(points: LatLng[]) {
    if (!this.mapLibreMap || points.length === 0) return;

    try {
      // 计算边界范围
      const bounds = LatLngBounds.fromLatLngArray(points);
      
      // 使用 getCameraForLatLngBounds 获取合适的相机位置
      const padding = 80; // 四周留 80 像素边距
      const camera = this.mapLibreMap.getCameraForLatLngBounds(
        bounds,
        padding, padding, padding, padding
      );

      if (camera) {
        // FlyTo 到计算出的相机位置
        const options: maplibre.CameraOptions = {
          center: camera.target,
          zoom: camera.zoom,
          bearing: camera.bearing,
          pitch: camera.tilt
        };
        this.mapLibreMap.flyTo(options, 2000);
        
        hilog.info(DOMAIN, TAG, `Flying to bounds: center=${camera.target.latitude},${camera.target.longitude}, zoom=${camera.zoom}`);
      }
    } catch (error) {
      hilog.error(DOMAIN, TAG, `Failed to fly to bounds: ${error}`);
    }
  }

  /**
   * 初始化地图
   */
  private initializeMap(map?: MapLibreMap) {
    if (this.isInitializing) {
      hilog.warn(DOMAIN, TAG, 'Map is already initializing');
      return;
    }
    
    if (!map) {
      hilog.error(DOMAIN, TAG, 'onMapReady: this.mapView is null');
      this.message = '❌ 地图初始化失败';
      return;
    }
    
    this.isInitializing = true;
    
    try {
      this.nativeMapView = map.getNativeMapView();
      this.mapLibreMap = map;
      
      this.mapReady = true;
      this.message = '✅ 地图已就绪 - 可以开始测试 Source';
      
      hilog.info(DOMAIN, TAG, 'Map is ready for Source testing');
    } catch (error) {
      const errorMsg = error instanceof Error ? error.message : String(error);
      hilog.error(DOMAIN, TAG, `Failed to initialize map: ${errorMsg}`);
      this.message = `❌ 初始化失败: ${errorMsg}`;
      this.mapReady = false;
    } finally {
      this.isInitializing = false;
    }
  }

  /**
   * 测试 GeoJsonSource - 点数据
   */
  private testGeoJsonPoint() {
    if (!this.mapLibreMap) return;
    const style = this.mapLibreMap.getStyle();
    if (!style) return;

    this.currentSource = 'GeoJsonSource - Point';

    try {
      // 移除旧的数据源和图层
      try {
        style.removeLayer('point-layer');
        style.removeSource('point-source');
      } catch (e) {
        // 忽略不存在的情况
      }

      // 生成随机位置
      const center = this.generateRandomLocation();
      const centerLng = center.longitude;
      const centerLat = center.latitude;

      const geojsonData = new IFeatureCollection([
        new IFeature({
          geometry: new GeoJson.Point([centerLng, centerLat]),
          properties: { name: "随机点", value: 100 }
        })
      ]);

      const source: GeoJsonSource = new GeoJsonSource('point-source');
      source.setGeoJson(geojsonData);
      style.addSource(source);

      const layer: CircleLayer = new CircleLayer('point-layer', 'point-source')
          .setCircleRadius(15)
        .setCircleColor('#ff0000')
        .setCircleOpacity(0.8);
      
      style.addLayer(layer as object);

      // FlyTo 到数据位置
      const allPoints = [LatLng.create(centerLat, centerLng)]
      this.flyToBounds(allPoints);

      hilog.info(DOMAIN, TAG, `GeoJsonSource ScreenPoint added at ${centerLat}, ${centerLng}`);
      this.message = '✅ 已添加 GeoJSON 点数据源';
    } catch (error) {
      const errorMsg = error instanceof Error ? error.message : String(error);
      hilog.error(DOMAIN, TAG, `Failed: ${errorMsg}`);
      this.message = `❌ 失败: ${errorMsg}`;
    }
  }

  /**
   * 测试 GeoJsonSource - 线数据
   */
  private testGeoJsonLine() {
    if (!this.mapLibreMap) return;
    const style = this.mapLibreMap.getStyle();
    if (!style) return;

    this.currentSource = 'GeoJsonSource - LineString';

    try {
      // 移除旧的数据源和图层
      try {
        style.removeLayer('line-layer');
        style.removeSource('line-source');
      } catch (e) {
        // 忽略不存在的情况
      }

      // 生成随机位置
      const center = this.generateRandomLocation();
      const centerLng = center.longitude;
      const centerLat = center.latitude;
      const offset = 1.5; // 线条偏移范围（适合 zoom=5）

      const geojsonData = new IFeatureCollection([
        new IFeature({
          geometry: new GeoJson.LineString([
            [centerLng - offset, centerLat],
            [centerLng, centerLat + offset * 0.5],
            [centerLng + offset, centerLat]
          ]),
          properties: { name: "测试路径" }
        })
      ]);

      const source: GeoJsonSource = new GeoJsonSource('line-source');
      source.setGeoJson(geojsonData);
      style.addSource(source);

      const layer: LineLayer = new LineLayer('line-layer', 'line-source')
          .setLineColor('#0000ff')
        .setLineWidth(4);
      
      style.addLayer(layer as object);

      // FlyTo 到数据位置
      const allPoints = [
        LatLng.create(centerLat, centerLng - offset),
        LatLng.create(centerLat + offset * 0.5, centerLng),
        LatLng.create(centerLat, centerLng + offset)
      ]
      this.flyToBounds(allPoints);

      hilog.info(DOMAIN, TAG, `GeoJsonSource Line added at ${centerLat}, ${centerLng}`);
      this.message = '✅ 已添加 GeoJSON 线数据源';
    } catch (error) {
      const errorMsg = error instanceof Error ? error.message : String(error);
      hilog.error(DOMAIN, TAG, `Failed: ${errorMsg}`);
      this.message = `❌ 失败: ${errorMsg}`;
    }
  }

  /**
   * 测试 GeoJsonSource - 面数据
   */
  private testGeoJsonPolygon() {
    if (!this.mapLibreMap) return;
    const style = this.mapLibreMap.getStyle();
    if (!style) return;

    this.currentSource = 'GeoJsonSource - Polygon';

    try {
      // 移除旧的数据源和图层
      try {
        style.removeLayer('polygon-layer');
        style.removeSource('polygon-source');
      } catch (e) {
        // 忽略不存在的情况
      }

      // 生成随机位置
      const center = this.generateRandomLocation();
      const centerLng = center.longitude;
      const centerLat = center.latitude;
      const offset = 1.5; // 多边形大小（适合 zoom=5）

      const geojsonData = new IFeatureCollection([
        new IFeature({
          geometry: new GeoJson.Polygon([[
            [centerLng - offset, centerLat - offset],
            [centerLng + offset, centerLat - offset],
            [centerLng + offset, centerLat + offset],
            [centerLng - offset, centerLat + offset],
            [centerLng - offset, centerLat - offset]
          ]]),
          properties: { name: "测试区域" }
        })
      ]);

      const source: GeoJsonSource = new GeoJsonSource('polygon-source');
      source.setGeoJson(geojsonData);
      style.addSource(source);

      const layer: FillLayer = new FillLayer('polygon-layer', 'polygon-source')
          .setFillColor('#00ff00')
        .setFillOpacity(0.5)
        .setFillOutlineColor('#000000');
      
      style.addLayer(layer as object);

      // FlyTo 到数据位置
      const allPoints = [
        LatLng.create(centerLat - offset, centerLng - offset),
        LatLng.create(centerLat - offset, centerLng + offset),
        LatLng.create(centerLat + offset, centerLng + offset),
        LatLng.create(centerLat + offset, centerLng - offset)
      ]
      this.flyToBounds(allPoints);

      hilog.info(DOMAIN, TAG, `GeoJsonSource Polygon added at ${centerLat}, ${centerLng}`);
      this.message = '✅ 已添加 GeoJSON 面数据源';
    } catch (error) {
      const errorMsg = error instanceof Error ? error.message : String(error);
      hilog.error(DOMAIN, TAG, `Failed: ${errorMsg}`);
      this.message = `❌ 失败: ${errorMsg}`;
    }
  }

  /**
   * 测试 GeoJsonSource - 聚类
   */
  private testGeoJsonCluster() {
    if (!this.mapLibreMap) return;
    const style = this.mapLibreMap.getStyle();
    if (!style) return;

    this.currentSource = 'GeoJsonSource - Cluster';

    try {
      // 移除旧的数据源和图层
      try {
        style.removeLayer('cluster-layer');
        style.removeSource('cluster-source');
      } catch (e) {
        // 忽略不存在的情况
      }

      // 生成随机中心位置
      const center = this.generateRandomLocation();
      const centerLng = center.longitude;
      const centerLat = center.latitude;
      const offset = 1.2; // 聚类点分布范围（适合 zoom=5）

      // 生成随机点数据
      const features: Array<IFeature> = [];
      const allPoints: LatLng[] = [];;
      
      for (let i = 0; i < 100; i++) {
        const lng: number = centerLng + (Math.random() - 0.5) * offset * 2;
        const lat: number = centerLat + (Math.random() - 0.5) * offset * 2;
        
        features.push(GeoJson.pointFeature(
          [lng, lat],
          { id: i }
        ));
        
        // 每 10 个点采样一个用于计算边界
        if (i % 10 === 0) {
          allPoints.push(LatLng.create(lat, lng));
        }
      }

      const geojsonData = GeoJson.featureCollection(features);

      // TODO: 聚类选项待完善
      const source: GeoJsonSource = new GeoJsonSource('cluster-source');
      source.setGeoJson(geojsonData);
      style.addSource(source);

      const layer: CircleLayer = new CircleLayer('cluster-layer', 'cluster-source')
          .setCircleRadius(10)
        .setCircleColor('#ff6600')
        .setCircleOpacity(0.8);
      
      style.addLayer(layer as object);

      // FlyTo 到数据位置
      this.flyToBounds(allPoints);

      hilog.info(DOMAIN, TAG, `GeoJsonSource Cluster added at ${centerLat}, ${centerLng}`);
      this.message = '✅ 已添加聚类数据源 (默认选项)';
    } catch (error) {
      const errorMsg = error instanceof Error ? error.message : String(error);
      hilog.error(DOMAIN, TAG, `Failed: ${errorMsg}`);
      this.message = `❌ 失败: ${errorMsg}`;
    }
  }

  /**
   * 测试 GeoJsonSource - 从 URL 加载
   */
  private testGeoJsonFromUrl() {
    if (!this.mapLibreMap) return;
    const style = this.mapLibreMap.getStyle();
    if (!style) return;

    this.currentSource = 'GeoJsonSource - URL';

    try {
      // 移除旧的数据源和图层
      try {
        style.removeLayer('url-layer');
        style.removeSource('url-source');
      } catch (e) {
        // 忽略不存在的情况
      }

      const source: GeoJsonSource = new GeoJsonSource('url-source');
      // 使用公开的 GeoJSON 数据源
      source.setUrl('https://raw.githubusercontent.com/maplibre/maplibre-gl-js/main/test/integration/data/countries.geojson');
      style.addSource(source);

      const layer: FillLayer = new FillLayer('url-layer', 'url-source')
          .setFillColor('#0080ff')
        .setFillOpacity(0.3)
        .setFillOutlineColor('#000000');
      
      style.addLayer(layer as object);

      // 生成随机位置并 flyTo（数据是全球的，选择一个随机位置查看）
      const center = this.generateRandomLocation();
      const options: maplibre.CameraOptions = {
        center: LatLng.create(center.latitude, center.longitude),
        zoom: 8
      };
      this.mapLibreMap.flyTo(options, 2000);

      hilog.info(DOMAIN, TAG, 'GeoJsonSource from URL added');
      this.message = '✅ 已添加从 URL 加载的 GeoJSON 数据源';
    } catch (error) {
      const errorMsg = error instanceof Error ? error.message : String(error);
      hilog.error(DOMAIN, TAG, `Failed: ${errorMsg}`);
      this.message = `❌ 失败: ${errorMsg}`;
    }
  }

  /**
   * 测试 VectorSource
   */
  private testVectorSource() {
    if (!this.mapLibreMap) return;
    const style = this.mapLibreMap.getStyle();
    if (!style) return;

    this.currentSource = 'VectorSource';

    try {
      // 移除旧的数据源
      try {
        style.removeSource('vector-source');
      } catch (e) {
        // 忽略不存在的情况
      }

      const source: VectorSource = new VectorSource('vector-source');
      source.setUrl('https://demotiles.maplibre.org/tiles/tiles.json');
      style.addSource(source);

      // 生成随机位置并 flyTo（矢量瓦片是全球的，选择一个随机位置查看）
      const center = this.generateRandomLocation();
      const options: maplibre.CameraOptions = {
        center: LatLng.create(center.latitude, center.longitude),
        zoom: 8
      };
      this.mapLibreMap.flyTo(options, 2000);

      hilog.info(DOMAIN, TAG, 'VectorSource added');
      hilog.info(DOMAIN, TAG, `  Source ID: ${source.getId()}`);
      hilog.info(DOMAIN, TAG, `  Source URL: ${source.getUrl()}`);
      
      this.message = '✅ 已添加 VectorSource 数据源';
    } catch (error) {
      const errorMsg = error instanceof Error ? error.message : String(error);
      hilog.error(DOMAIN, TAG, `Failed: ${errorMsg}`);
      this.message = `❌ 失败: ${errorMsg}`;
    }
  }

  /**
   * 测试 RasterSource - OSM
   */
  private testRasterSource() {
    if (!this.mapLibreMap) return;
    const style = this.mapLibreMap.getStyle();
    if (!style) return;

    this.currentSource = 'RasterSource - OSM';

    try {
      // 移除旧的数据源
      try {
        style.removeSource('osm-raster');
      } catch (e) {
        // 忽略不存在的情况
      }

      const source: RasterSource = new RasterSource('osm-raster');
      source.setUrl('https://tile.openstreetmap.org/{z}/{x}/{y}.png');
      style.addSource(source);

      // 生成随机位置并 flyTo（栅格瓦片是全球的，选择一个随机位置查看）
      const center = this.generateRandomLocation();
      const options: maplibre.CameraOptions = {
        center: LatLng.create(center.latitude, center.longitude),
        zoom: 8
      };
      this.mapLibreMap.flyTo(options, 2000);

      hilog.info(DOMAIN, TAG, 'RasterSource (OSM) added');
      hilog.info(DOMAIN, TAG, `  Source ID: ${source.getId()}`);
      hilog.info(DOMAIN, TAG, `  Source URL: ${source.getUrl()}`);
      
      this.message = '✅ 已添加 RasterSource (OSM) 数据源';
    } catch (error) {
      const errorMsg = error instanceof Error ? error.message : String(error);
      hilog.error(DOMAIN, TAG, `Failed: ${errorMsg}`);
      this.message = `❌ 失败: ${errorMsg}`;
    }
  }

  /**
   * 测试 RasterSource - 卫星影像
   */
  private testRasterSourceSatellite() {
    if (!this.mapLibreMap) return;
    const style = this.mapLibreMap.getStyle();
    if (!style) return;

    this.currentSource = 'RasterSource - Satellite';

    try {
      // 移除旧的数据源
      try {
        style.removeSource('satellite-raster');
      } catch (e) {
        // 忽略不存在的情况
      }

      const source: RasterSource = new RasterSource('satellite-raster');
      // 使用示例卫星影像服务
      source.setUrl('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}');
      style.addSource(source);

      // 生成随机位置并 flyTo（卫星影像是全球的，选择一个随机位置查看）
      const center = this.generateRandomLocation();
      const options: maplibre.CameraOptions = {
        center: LatLng.create(center.latitude, center.longitude),
        zoom: 8
      };
      this.mapLibreMap.flyTo(options, 2000);

      hilog.info(DOMAIN, TAG, 'RasterSource (Satellite) added');
      this.message = '✅ 已添加卫星影像数据源';
    } catch (error) {
      const errorMsg = error instanceof Error ? error.message : String(error);
      hilog.error(DOMAIN, TAG, `Failed: ${errorMsg}`);
      this.message = `❌ 失败: ${errorMsg}`;
    }
  }

  /**
   * 清除所有自定义数据源
   */
  private clearAllSources() {
    if (!this.mapLibreMap) return;
    const style = this.mapLibreMap.getStyle();
    if (!style) return;

    this.currentSource = '无';

    try {
      // 移除所有测试图层
      const layerIds = [
        'point-layer', 'line-layer', 'polygon-layer', 'cluster-layer',
        'url-layer'
      ]

      layerIds.forEach(layerId => {
        try {
          style.removeLayer(layerId);
        } catch (e) {
          // 忽略不存在的图层
        }
      });

      // 移除所有测试数据源
      const sourceIds = [
        'point-source', 'line-source', 'polygon-source', 'cluster-source',
        'url-source', 'vector-source', 'osm-raster', 'satellite-raster'
      ]

      sourceIds.forEach(sourceId => {
        try {
          style.removeSource(sourceId);
        } catch (e) {
          // 忽略不存在的数据源
        }
      });

      hilog.info(DOMAIN, TAG, 'All sources cleared');
      this.message = '✅ 已清除所有数据源';
    } catch (error) {
      const errorMsg = error instanceof Error ? error.message : String(error);
      hilog.error(DOMAIN, TAG, `Failed to clear sources: ${errorMsg}`);
      this.message = `❌ 清除失败: ${errorMsg}`;
    }
  }
  
