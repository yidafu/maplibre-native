+
+struct VertexStage {
+    float2 a_pos [[attribute(0)]];
+    float2 a_tex [[attribute(1)]];
+};
+
+struct FragmentStage {
+    float4 position [[position, invariant]];
+    half2 tex;
+};
+
+float2 rotateVec2(float2 v, float angle) {
+    float cosA = cos(angle);
+    float sinA = sin(angle);
