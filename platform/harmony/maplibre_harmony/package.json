{
  "name": "maplibre-harmony",
  "version": "0.2.0-alpha.2",
  "description": "MapLibre Native for HarmonyOS - OpenGL-based vector map rendering library",
  "main": "index.ets",
  "scripts": {
    "prepublishOnly": "cd .. && bash ./pre-release.sh \"$npm_package_version\"",
    "update:version": "cd .. && bash ./pre-release.sh"
  },
  "keywords": [
    "maplibre",
    "mapbox",
    "maps",
    "vector",
    "tiles",
    "opengl",
    "harmonyos",
    "ohos",
    "native",
    "rendering",
    "geospatial"
  ],
  "author": "yidafu",
  "license": "BSD-2-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yidafu/maplibre-native.git",
    "directory": "platform/harmony/maplibre_harmony"
  },
  "bugs": {
    "url": "https://github.com/yidafu/maplibre-native/issues"
  },
  "homepage": "https://github.com/yidafu/maplibre-native/tree/harmony/platform/harmony",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "tag": "alpha"
  },
  "files": [
    "index.ets",
    "src/main/ets/**/*",
    "src/main/cpp/**/*",
    "!src/main/cpp/thirdparty/**/*",
    "src/main/resources/**/*",
    "libs/**/*.so",
    "build-profile.json5",
    "obfuscation-rules.txt",
    "hvigorfile.ts",
    "oh-package.json5",
    "README.md",
    "mapping",
    "docs/api",
    "maplibre_harmony.har"
  ]
}
