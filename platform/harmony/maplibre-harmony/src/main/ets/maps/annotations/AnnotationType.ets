/**
 * AnnotationType - enumeration of supported annotation types.
 *
 * Defines the annotation kinds available on the map.
 */
export enum AnnotationType {
  /**
   * Point annotation (marker).
   */
  MARKER = 'marker',

  /**
   * Polyline annotation.
   */
  POLYLINE = 'polyline',

  /**
   * Polygon annotation.
   */
  POLYGON = 'polygon'
}

